# ======================================================================
# ARCANA AI BRAIN — ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================================

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000

# AI / LLM Provider Configuration
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding & Vector Retrieval Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_STORE_PROVIDER=memory

# Chunking Configuration
CHUNKING_VERSION=1.0
MAX_CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retry & Timeout Policy
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
